# Bot トークン（必須）
DISCORD_TOKEN=

# AI バックエンド
#   gemini : Gemini API に直接接続する
#   cmd    : Command Code CLI を子プロセスで実行する（従来方式）
AI_BACKEND=gemini

# Gemini 直結バックエンドの設定（AI_BACKEND=gemini のとき必須）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini の会話履歴（チャンネル/スレッドごと）
GEMINI_HISTORY_FILE=./gemini-history.json
GEMINI_MAX_HISTORY_MESSAGES=40
GEMINI_TIMEOUT_MS=180000
GEMINI_MAX_OUTPUT_TOKENS=8192

# Google Search グラウンディングを使うか（対応モデルのみ）
GEMINI_GOOGLE_SEARCH=false

# システムプロンプトを差し替える場合（任意）
# GEMINI_SYSTEM_PROMPT=

# 許可する Discord ユーザー ID（カンマ区切り、任意）
# 空の場合は、bot が参加しているギルドの全ユーザーを許可する
ALLOWED_USER_IDS=

# 許可するチャンネル ID（カンマ区切り、任意）
# 空の場合は全チャンネルを許可する
ALLOWED_CHANNEL_IDS=

# /cwd で移動できるルート（カンマ区切り、必須）
ALLOWED_ROOTS=/srv/work

# 以下は AI_BACKEND=cmd のときだけ使う
# cmd の実行パス
CMD_BIN=cmd

# 同時に走らせる cmd プロセスの上限
MAX_CONCURRENCY=3

# セッション状態の保存先
SESSIONS_FILE=./sessions.json

# 進捗メッセージを編集する間隔（ミリ秒）
PROGRESS_INTERVAL_MS=1750

# フォーラム投稿ごとに作業ディレクトリを分けるか
#   auto   : <DEFAULT_CWD>/<フォーラム名>/<投稿名> を自動作成（/cwd で指定した場合は維持）
#   shared : 全投稿で DEFAULT_CWD を共有する
FORUM_CWD=auto

# 受信した添付を削除するまでの時間（時間）。0（既定）で削除しない
# 容量が厳しくなったら、スレッドの作業ディレクトリごと STORAGE_TARGET_PERCENT で削除される
UPLOAD_TTL_HOURS=0

# 添付の削除を実行する間隔（分、最小 5）。UPLOAD_TTL_HOURS=0 のときは使われない
UPLOAD_SWEEP_INTERVAL_MINUTES=60

# 作業ディレクトリの使用率がこれを超えたら、古いスレッドの作業ディレクトリを削除する（%）
# 0 で自動削除を無効化
STORAGE_TARGET_PERCENT=75

# SMART が warning / critical のときに使う、より厳しい目標（%）
STORAGE_DEGRADED_PERCENT=60

# 容量調整を実行する間隔（分、最小 10）
STORAGE_SWEEP_INTERVAL_MINUTES=60

# SMART の健全性スナップショット（gemini-disk-health.timer が書き出す JSON）
SMART_FILE=/var/lib/gemini-discordbot/smart.json

# 作業ディレクトリの AGENTS.md に自動更新ブロックを書くか
#   thread : bot が自動作成したスレッドのディレクトリだけ（既定）
#   always : すべての cwd
#   off    : 書かない
WORKDIR_META=thread

# 他のスレッドが使用中のディレクトリへ /cwd したときの扱い
#   deny : 拒否する（force:true で上書き可能）
#   warn : 許可してログに残す
CWD_CONFLICT=deny

# メッセージに反応する条件
#   prefix : 先頭が `!` のメッセージだけ実行する（既定・スレッド内の雑談に介入しない）
#   all    : すべてのメッセージに反応する（従来の挙動）
TRIGGER_MODE=prefix

# 初回メッセージの既定 cwd（ALLOWED_ROOTS 配下、任意）
# 未指定なら ALLOWED_ROOTS の先頭を使う
DEFAULT_CWD=

# cmd の既定モデル（任意、/model でチャンネルごとに上書きできる）
# vision 対応・cache read が $0.003/1M と安いので、--resume 中心の運用に向く
CMD_MODEL=deepseek/deepseek-v4.1-flash

# cmd の既定推論強度（任意、/model effort:<level> で上書きできる）
# 最速重視なら off。モデルが対応していない値は実行時に無視される
CMD_EFFORT=off
